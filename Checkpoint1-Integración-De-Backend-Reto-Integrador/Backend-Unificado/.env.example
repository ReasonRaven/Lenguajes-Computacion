# Copia este archivo a .env y pon tu API Key de Google Gemini
# (se obtiene gratis en https://aistudio.google.com/apikey).
# Sin GEMINI_API_KEY las explicaciones usan las plantillas predefinidas.
GEMINI_API_KEY=AIza...
# Modelo que genera las explicaciones. Los "lite" son más rápidos y suelen estar
# menos saturados; otros: gemini-flash-latest, gemini-3.8-flash.
GEMINI_MODEL=gemini-3.5-flash-lite
# Segundos máximos de espera por cada llamada a Gemini.
GEMINI_TIMEOUT=20
